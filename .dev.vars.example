# Copy this file to .dev.vars for local development. Never commit .dev.vars.
TELEGRAM_BOT_TOKEN="replace-with-a-test-bot-token"
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-32-character-secret"
LLM_API_KEY="replace-with-your-model-api-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="replace-with-your-model-id"
ALLOWED_TELEGRAM_USER_IDS="123456789"
SYSTEM_PROMPT="You are microbot, a concise and helpful Telegram assistant."
MAX_HISTORY_MESSAGES="12"
LLM_TIMEOUT_MS="25000"
